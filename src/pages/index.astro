---
import { sites } from "../config/sites";
import "../styles/global.css";
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="jirachi_tanが制作している非公式ファンサイト・データベースの一覧。" />
		<title>jirachi_tan | FANMADE PROJECTS</title>
	</head>
	<body>
		<main>
			<header class="site-header">
				<h1>jirachi_tan</h1>
				<p class="eyebrow">FANMADE PROJECTS</p>
				<p class="intro">趣味で制作している<br />非公式ファンサイト・データベースです。</p>
			</header>

			<section class="projects" aria-labelledby="projects-heading">
				<h2 id="projects-heading" hidden>制作サイト一覧</h2>
				{sites.map((site) => (
					<article class="project" style={`--accent: ${site.accent}`}>
						<div class="project-heading">
							<h2>{site.title}</h2>
							<p class="work">{site.work}</p>
						</div>
						<div class="project-body">
							<p class="description">{site.description}</p>
							<a class="project-link" href={site.url} target="_blank" rel="noopener noreferrer">
								サイトを見る →
							</a>
						</div>
					</article>
				))}
			</section>
		</main>

		<footer>
			<div class="footer-rule"></div>
			<a class="footer-link" href="https://x.com/jirachi_tan" target="_blank" rel="noopener noreferrer">
				X @jirachi_tan
			</a>
			<p class="footer-note">掲載している各サイトは非公式ファンサイトです。<br />各作品の公式・関係各社とは関係ありません。</p>
		</footer>
		<!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "94bc5bfadb6648caabc83ecbc4832eff"}'></script><!-- End Cloudflare Web Analytics -->
	</body>
</html>
